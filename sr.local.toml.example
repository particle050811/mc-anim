# 本机配置模板：拷成 sr.local.toml（不进 Git，放主检出根目录，worktree 共用）再改。
# 键是环境变量名去掉 SR_ 的小写。每项都可以不写；取值顺序是 环境变量 > sr.local.toml > 默认。相对路径相对本文件所在目录。
# sr env 列出每一项现在的值和取自哪一层。

# Git 外的数据根（store、私有、terrain、cache、交付、run）。环境变量 SR_DATA。默认：主检出同级的 stress-rotation-data
# data = "../stress-rotation-data"

# 旧项目根（迁移期：旧项目执行器、基线）。环境变量 SR_LEGACY。默认：主检出同级的 机械动力应力转动-AI漫画
# legacy = "../机械动力应力转动-AI漫画"

# 游戏环境（取材服务端、Prism 实例、jar 缓存）。环境变量 SR_GAME。默认：<旧项目>/game
# game = "../stress-rotation-game"

# 资源闸锁目录。环境变量 SR_LOCK_DIR。默认：旧项目在就用 <旧项目>/.资源闸（两个项目一起排队），否则 <数据根>/run/locks
# lock_dir = "../机械动力应力转动-AI漫画/.资源闸"

# 成片视频编码器：h264_videotoolbox 或 libx264。环境变量 SR_VIDEO_ENCODER。默认：Mac 用 h264_videotoolbox，其余 libx264
# video_encoder = "libx264"

# 无头 Chrome 的 WebGL 后端：angle、swangle、egl、swiftshader、vulkan、angle-egl。环境变量 SR_GL。默认 angle
# gl = "angle"

# ffmpeg、ffprobe 程序。环境变量 SR_FFMPEG、SR_FFPROBE。默认从 PATH 找
# ffmpeg = 'D:\tools\ffmpeg\bin\ffmpeg.exe'
# ffprobe = 'D:\tools\ffmpeg\bin\ffprobe.exe'

# 渲染放行要的空闲内存百分比。环境变量 SR_RENDER_FREE_MIN。默认 30
# render_free_min = 30

# 本机名（写进锁旁的 .主机 文件和运行记录）。环境变量 SR_HOST。默认取系统主机名
# host = "笔记本"
