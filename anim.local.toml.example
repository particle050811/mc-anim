# 本机配置模板：拷成 anim.local.toml（不进 Git，放主检出根目录，worktree 共用）再改。
# 键是环境变量名去掉 ANIM_ 的小写。每项都可以不写；取值顺序是 环境变量 > anim.local.toml > 默认。相对路径相对本文件所在目录。
# anim env 列出每一项现在的值和取自哪一层。

# 默认作品：没给 --作品、当前目录也不在哪部作品里时用它；只有一部作品时不用写。环境变量 ANIM_WORK
# work = "应力转动"

# Git 外的数据根（store、私有、terrain、cache、交付、run）。环境变量 ANIM_DATA。默认：主检出同级的 mc-anim-data
# data = "../mc-anim-data"

# 旧项目根（迁移期：旧项目执行器、基线）。环境变量 ANIM_LEGACY。默认：主检出同级的 机械动力应力转动-AI漫画
# legacy = "../机械动力应力转动-AI漫画"

# 游戏环境（取材服务端、Prism 实例、jar 缓存）。环境变量 ANIM_GAME。默认：<旧项目>/game
# game = "../mc-anim-game"

# JDK 17：编译取材 mod（anim mcai build、anim check 的 mod 编译和核对）、取材脚本里的 javap。环境变量 ANIM_JAVA_HOME。默认空：用 PATH 上的 java
# java_home = "/opt/homebrew/opt/openjdk@17"

# Prism Launcher 程序（anim mcai 起游戏）。环境变量 ANIM_PRISM。默认空：从 PATH 找
# prism = 'C:\Users\me\AppData\Local\Programs\PrismLauncher\prismlauncher.exe'

# Prism Launcher 的数据目录。环境变量 ANIM_PRISM_DATA。默认：Mac ~/Library/Application Support/PrismLauncher，Windows %APPDATA%\PrismLauncher，Linux ~/.local/share/PrismLauncher
# prism_data = "/Users/me/Library/Application Support/PrismLauncher"

# 原版资源目录（objects/、indexes/，导音效用）。环境变量 ANIM_MC_ASSETS。默认：<Prism 数据目录>/assets
# mc_assets = "../mc-assets"

# 跑 mcai 和取材脚本的 Python。环境变量 ANIM_PYTHON。默认：Windows 上 python，其余 python3
# python = "python3"

# 资源闸锁目录。环境变量 ANIM_LOCK_DIR。默认：旧项目在就用 <旧项目>/.资源闸（两个项目一起排队），否则 <数据根>/run/locks
# lock_dir = "../机械动力应力转动-AI漫画/.资源闸"

# 成片视频编码器：h264_videotoolbox 或 libx264。环境变量 ANIM_VIDEO_ENCODER。默认：Mac 用 h264_videotoolbox，其余 libx264
# video_encoder = "libx264"

# 无头 Chrome 的 WebGL 后端：angle、swangle、egl、swiftshader、vulkan、angle-egl。环境变量 ANIM_GL。默认 angle
# gl = "angle"

# ffmpeg、ffprobe 程序。环境变量 ANIM_FFMPEG、ANIM_FFPROBE。默认从 PATH 找
# ffmpeg = 'D:\tools\ffmpeg\bin\ffmpeg.exe'
# ffprobe = 'D:\tools\ffmpeg\bin\ffprobe.exe'

# 渲染放行要的空闲内存百分比。环境变量 ANIM_RENDER_FREE_MIN。默认 30
# render_free_min = 30

# 本机名（写进锁旁的 .主机 文件和运行记录）。环境变量 ANIM_HOST。默认取系统主机名
# host = "笔记本"

# agent-context 里本作品的记忆目录（规矩表出处 M/ 的根，anim check 查引用的记忆在不在；不在本机就跳过）。环境变量 ANIM_MEMORY。默认 ~/Developer/company/agent-context/memory/projects/stress-rotation-comic
# memory = "/Users/me/Developer/company/agent-context/memory/projects/stress-rotation-comic"

# 剪映专业版（Mac 版的 .app；anim jianying readback 解密草稿用它的库）。环境变量 ANIM_JIANYING_APP。默认 /Applications/VideoFusion-macOS.app
# jianying_app = "/Applications/VideoFusion-macOS.app"

# 剪映的草稿目录（anim edit-package、anim jianying export 写进这里）。环境变量 ANIM_JIANYING_DRAFTS。默认 ~/Movies/JianyingPro/User Data/Projects/com.lveditor.draft
# jianying_drafts = "/Users/me/Movies/JianyingPro/User Data/Projects/com.lveditor.draft"

# 私有作品的位置：作品名 = 目录（中文名要加引号；相对路径相对本文件）。放在 作品/<名>/ 的私有作品也登记在这，worktree 里才找得到
# [works]
# "私有甲" = "../私有甲"
