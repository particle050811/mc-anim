{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "paths": { "@engine/*": ["./engine/*"], "@库/*": ["./库/*"] }
  },
  "include": ["engine", "库", "作品", "pipeline", "assets/src", "remotion.config.ts", "vitest.config.ts"]
}
